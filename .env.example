# Frontend (public, safe to expose)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Scripts only (never commit real values)
SUPABASE_PROJECT_REF=<project-ref>
SUPABASE_DB_PASSWORD=
# Optional: IPv4 session pooler host (e.g. aws-1-eu-central-1.pooler.supabase.com) when the
# direct db.<ref>.supabase.co host (IPv6 only) is unreachable from your network
SUPABASE_DB_HOST=

# Payments (server-side only: set in Vercel, never in VITE_ vars). npm run stripe:setup fills the last two.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENTS_RPC_SECRET=
